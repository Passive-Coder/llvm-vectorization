{"kind":"textbox","id":"sh/oryp8fah","slideIndex":5,"position":{"left":64,"top":636.14,"width":588.79,"height":20.02},"name":"Text 6","text":"Native 128-bit vector types: <2 x i64>, <4 x i32>, <4 x float>, <8 x i16>, <16 x i8>","geometry":"rect","style":{"fontSize":14.67,"typeface":"Exo","color":"#9D9D9D","alignment":"left"}}
